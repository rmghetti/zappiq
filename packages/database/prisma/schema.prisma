  facts              Json         @default("{}")
  recommendedActions Json         @default("[]")
  source             String       @default("llm") // llm | rule
  createdAt          DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("analytics_insights")
}

/// Maestro v2 — espera durável de wait/schedule (fonte de verdade; o job BullMQ é só o despertador).
model FlowTimer {
  id             String    @id @default(cuid())
  organizationId String
  /// Sem FK para conversations: intencional. Timers são limpos via cascade do flow e validados no momento do disparo; uma purga de conversa deixa apenas linhas inertes.
  conversationId String
  flowId         String
  flow           Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowVersion    Int
  kind           String // 'wait' | 'schedule'
  resumeNodeId   String
  stateSnapshot  Json
  runAt          DateTime
  status         String    @default("pending") // 'pending' | 'fired' | 'cancelled' | 'expired'
  statusReason   String?
  jobId          String?
  createdAt      DateTime  @default(now())
  firedAt        DateTime?

  @@index([status, runAt])
  @@index([organizationId, conversationId, status])
  @@map("flow_timers")
}

model FlowTemplate {
