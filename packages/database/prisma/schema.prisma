// ═══════════════════════════════════════════════════════════════════
// QAPair — Perguntas & Respostas editáveis pelo cliente
// ─────────────────────────────────────────────────────────────────
// Estrutura explícita (pergunta → resposta) para casos em que o cliente
// quer "fixar" uma resposta sem depender de RAG de documento longo.
// Ingerido como chunks no vector store, mas mantido como registro
// canônico editável no CRUD. Categoria opcional para agrupamento
// (ex.: "horário de atendimento", "política de trocas", "pricing").
// ═══════════════════════════════════════════════════════════════════
model QAPair {
  id             String       @id @default(cuid())
  question       String
  answer         String
  category       String?
  priority       Int          @default(0) // ordem de exibição / peso no RAG
  isActive       Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // ID do chunk correspondente no vector store — permite resync sem duplicar.
  ragChunkId     String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("qa_pairs")
}

model Deal {
  id                   String         @id @default(cuid())
  title                String
  value                Decimal?
  // Legado: estágio textual livre. Mantido p/ back-compat; a fonte canônica
  // passa a ser stageId (PipelineStage). Sincronizados na transição.
  stage                String         @default("new")
  stageId              String?
  pipelineStage        PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  // CRM (Onda 0): dono, previsão, atribuição e desfecho.
  ownerId              String?
  expectedCloseDate    DateTime?
  lossReason           LossReason?
  sourceCampaignId     String?
  sourceAgentId        String?
  // Fase B (atribuição IA): conversa que originou/destravou a venda (vínculo
  // conversa→deal). aiLinkReviewed = já confirmado/rejeitado por humano.
  sourceConversationId String?
  sourceConversation   Conversation?  @relation("DealSourceConversation", fields: [sourceConversationId], references: [id], onDelete: SetNull)
  aiLinkReviewed       Boolean        @default(false)
  wonAt                DateTime?
  lostAt               DateTime?
  contactId            String
  contact              Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId       String
  activities           Activity[]
  tasks                Task[]
  closedAt             DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@index([stageId])
  @@map("deals")
}

// ═══════════════════════════════════════════════════════════════════
// CRM sinérgico (Onda 0) — pipeline + timeline de atividades + tarefas
// ─────────────────────────────────────────────────────────────────
// PipelineStage: estágios ordenáveis por org (seed: Novo→...→Ganho/Perdido).
// Activity: feed cronológico unificado (mensagens, mudança de estágio, notas,
//   tarefas, eventos de campanha, resumos da IA) — fonte da timeline do contato.
// Task: próximo passo com dono e prazo, ligado a contato/deal.
// ═══════════════════════════════════════════════════════════════════
enum ActivityType {
  CONTACT_CREATED
  MESSAGE
  STAGE_CHANGE
  NOTE
  TASK_CREATED
  TASK_COMPLETED
  CAMPAIGN_EVENT
  AI_SUMMARY
  FIELD_UPDATE
  LEAD_SCORE_CHANGE
  DEAL_CREATED
  DEAL_WON
  DEAL_LOST
}

enum ActorType {
  HUMAN
  AI
  SYSTEM
}

/// IN_PROGRESS entrou em 15/07/2026 com o quadro de tarefas: sem ele o quadro
/// teria duas colunas ("a fazer" e "feito") e a pessoa não teria onde dizer que
/// pegou a tarefa. É um status INTERMEDIÁRIO — não conclui nada, então
/// completedAt continua null (ver resolveCompletedAt).
enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum LossReason {
  PRICE
  COMPETITOR
  TIMING
  NO_DECISION
  NO_BUDGET
  NO_RESPONSE
  OTHER
}

model PipelineStage {
  id             String       @id @default(cuid())
  name           String
  order          Int          @default(0)
  color          String?
  isWon          Boolean      @default(false)
  isLost         Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals          Deal[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("pipeline_stages")
}

model Activity {
  id             String        @id @default(cuid())
  type           ActivityType
  actor          ActorType     @default(SYSTEM)
  actorUserId    String?
  title          String
  body           String?
  metadata       Json?
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
  @@index([conversationId])
  @@index([createdAt])
  @@map("activities")
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus   @default(PENDING)
  dueDate        DateTime?
  /// O que o HUMANO anota enquanto executa. Deliberadamente separado de
  /// `description`: aquela é o texto que a IA escreveu (o plano de ação, o
  /// alerta do release) e reescrevê-la apagaria a instrução original.
  notes          String?
  assignedToId   String?
  /// Relação que faltava até 15/07/2026: `assignedToId` existia como String
  /// solta desde o começo, sem FK, sem include e sem ninguém escrevendo (só o
  /// seed). Toda tarefa nascia sem dono, então "minhas tarefas" não existia.
  assignedTo     User?        @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  tags           TaskTagOnTask[]
  completedAt    DateTime?
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  /// Conversa que gerou a tarefa (16/07/2026). O TaskPanel já tinha o link
  /// "ver a conversa" pronto na intenção, mas o dado nunca foi persistido —
  /// crmAutomationService já recebe `conversationId` e o usa nas Activity
  /// vizinhas, só não estava aqui. SetNull: LGPD pode anonimizar/apagar a
  /// conversa e a tarefa (o trabalho do vendedor) continua existindo.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  /// Campanha do Zap Impulso que esta tarefa cobra aprovação (16/07/2026).
  /// SetNull: apagar a campanha não deveria apagar o registro de que alguém
  /// precisou revisar algo.
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  /// De onde veio a tarefa. Até 15/07/2026 TODA Task nascia das Conversas
  /// (crmAutomationService, quando a IA detecta intenção de compra), então a
  /// origem era implícita. Com o Mira gerando tarefa de plano de ação, a tela
  /// precisa dizer de onde cada uma veio: são trabalhos diferentes (responder
  /// alguém que chamou x prospectar alguém que nem sabe que você existe).
  origem         TaskOrigem   @default(CONVERSA)
  /// Alvo do Mira que gerou esta tarefa (id solto, sem cascade: a tarefa é do
  /// vendedor e não some se o Alvo for arquivado).
  miraAlvoId     String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
  @@index([conversationId])
  @@index([campaignId])
  @@index([status])
  @@index([assignedToId])
  @@index([miraAlvoId])
  @@map("tasks")
}

/// Origem de uma tarefa. CONVERSA é o default por compatibilidade: toda Task
/// que já existia no banco nasceu das Conversas. IMPULSO entrou 16/07/2026:
/// pedir aprovação de campanha não é "responder quem chamou" nem "prospectar" —
/// é revisar o que a IA vai enviar em nome da conta antes de sair.
enum TaskOrigem {
  CONVERSA
  MIRA
  IMPULSO
}

/// Etiqueta de tarefa, por CATÁLOGO da org (decisão do Rodrigo em 15/07/2026:
/// não é texto livre). Texto livre viraria "Urgente", "urgente" e "URGENTE" na
/// mesma conta e o filtro por etiqueta — que é o motivo de existir da etiqueta —
/// não acharia nada.
model TaskTag {
  id             String          @id @default(cuid())
  name           String
  /// Cor em hex (#RRGGBB). A etiqueta precisa ser reconhecida antes de ser
  /// lida, senão o quadro vira uma parede de texto cinza.
  color          String
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          TaskTagOnTask[]
  createdAt      DateTime        @default(now())

  /// O catálogo é por org e o nome é a identidade da etiqueta: duas "Urgente"
  /// na mesma conta derrotariam o propósito do catálogo.
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("task_tags")
}

/// Ligação tarefa ↔ etiqueta. Explícita (e não m2m implícita do Prisma) para o
/// join ter tabela com nome previsível — a RLS precisa escrever política nela.
model TaskTagOnTask {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId     String
  tag       TaskTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tags_on_tasks")
}

model MessageTemplate {
  id             String       @id @default(cuid())
  name           String
  category       String
  language       String       @default("pt_BR")
  headerType     String?
  headerContent  String?
  bodyText       String
  footerText     String?
  buttons        Json?
  metaStatus     String       @default("PENDING")
  metaTemplateId String?
  // Mapa de preenchimento das variáveis {{1}}, {{2}}... do bodyText por contato.
  // Array de { index, source: 'contact.firstName'|'contact.name'|'contact.company'|'fixed',
  // fixedText?, fallback }. Sem esse mapa (ou incompleto), o disparo cai em texto.
  variables      Json?
  // FEATURE 5b.2 — template usado pra REABRIR a janela de 24h da Meta.
  // Fora da janela de 24h a Meta rejeita mensagem free-form; só templates
  // aprovados passam. isReengagement marca os templates elegíveis pra esse uso.
  isReengagement Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns      Campaign[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("message_templates")
}

model InternalNote {
  id             String       @id @default(cuid())
  content        String
  authorId       String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("internal_notes")
}

// LGPD Art. 37 (ROPA) + Art. 46 (segurança) + Art. 48 (incidentes)
// Cadeia hash garante detecção de adulteração. Append-only via policy de banco.
model AuditLog {
  id             String      @id @default(cuid())
  sequence       BigInt      @default(autoincrement()) // ordem estrita p/ cadeia
  action         String // e.g. "conversation.delete"
  resource       String // e.g. "conversation"
  resourceId     String? // id do recurso tocado
  purpose        String? // LGPD Art. 6 — finalidade
  legalBasis     LegalBasis? // LGPD Art. 7/11
  dataSubjectId  String? // contactId quando toca dados pessoais
  details        Json?
  before         Json? // snapshot antes (forense)
  after          Json? // snapshot depois
  ipAddress      String?
  userAgent      String?
  hash           String? // SHA-256 do registro (null em linhas legacy)
  prevHash       String? // hash do registro anterior (chain)
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  organizationId String
  anonymizedAt   DateTime? // LGPD Art. 16 — marcado ao anonimizar
  createdAt      DateTime    @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([resource, resourceId])
  @@index([dataSubjectId])
  @@index([createdAt])
  @@index([sequence])
  @@map("audit_logs")
}

// LGPD Art. 18 — requisições do titular dos dados
model DataSubjectRequest {
  id              String                   @id @default(cuid())
  type            DataSubjectRequestType
  status          DataSubjectRequestStatus @default(PENDING)
  requesterEmail  String // email do titular
  requesterName   String?
  contactId       String? // Contact.id se identificado
  reason          String? // justificativa do titular
  responseData    Json? // payload da resposta (para ACCESS/PORTABILITY)
  handledById     String? // user.id do operador
  rejectionReason String?
  dueDate         DateTime // prazo legal (15 dias — Art. 19)
  completedAt     DateTime?
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([contactId])
  @@index([dueDate])
  @@map("data_subject_requests")
}

model Consent {
  id        String    @id @default(cuid())
  contactId String
  type      String
  status    String
  grantedAt DateTime?
  revokedAt DateTime?
  channel   String?
  createdAt DateTime  @default(now())

  @@index([contactId])
  @@map("consents")
}

// ═══════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════
// V2-021 · Agent (Sprint 0 — Plano §11.3)
// Persona configurável por Organization. 2 seed por org:
// comercial (lead/trial) + suporte (customer). Builder
// self-service Q3 estende esse modelo.
// ═══════════════════════════════════════════════════════
model Agent {
  id              String         @id @default(uuid()) @db.Text
  organizationId  String         @map("organization_id")
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String // "Iza", "Bella", "Ana"
  role            String // 'comercial' | 'suporte' | 'onboarding' | 'financeiro'
  status          String         @default("live") // 'draft' | 'reviewed' | 'live'
  systemPrompt    String         @map("system_prompt") @db.Text
  toneConfig      Json           @default("{}") @map("tone_config")
  scopeConfig     Json           @default("{}") @map("scope_config")
  abilities       Json           @default("{}")
  knowledgeBaseId String?        @map("knowledge_base_id")
  knowledgeBase   KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  voiceConfig     Json?          @map("voice_config") // null até voz voltar Q3
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  evalRuns        AgentEvalRun[]

  @@index([organizationId, role, status])
  @@map("agents")
}

// FASE 1.B task #240 — Onboarding journey D+1/D+3/D+7 state.
// Idempotência: 1 row por (org, stage). Reusa templates existentes
// (trialSavingsFollowup, trialMidway, trialLastDay) wireados via
// onboardingJourneyService.ts. Cron horário no boot do server.
model OnboardingJourneyState {
  id              String       @id @default(uuid()) @db.Text
  organizationId  String       @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage           String // 'D1' | 'D3' | 'D7'
  sentAt          DateTime     @default(now()) @map("sent_at")
  emailProviderId String?      @map("email_provider_id") // Resend ID ou 'log:...'
  templateId      String       @map("template_id")
  // Snapshot da org no momento do send (debug)
  orgSnapshot     Json?        @map("org_snapshot")

  @@unique([organizationId, stage])
  @@index([sentAt])
  @@map("onboarding_journey_state")
}

// V3.2 task #237 — Persistência de eval runs (golden set scoring).
// Roda sob demanda (manual via API) ou via cron diário (V3.3 futuro).
// Permite histórico de score por agent + alerta se degrada.
model AgentEvalRun {
  id               String    @id @default(uuid()) @db.Text
  agentId          String    @map("agent_id")
  agent            Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // 'pending' (criada, ainda não rodou) | 'running' | 'completed' | 'failed'
  status           String    @default("pending")
  // Versão do eval set usada (ex: 'v1') — pra rastrear quando set muda
  evalSetVersion   String    @map("eval_set_version")
  // Versão do CORE rules usada (ex: 'v1') — pra rastrear quando CORE muda
  coreRulesVersion String?   @map("core_rules_version")
  // Trigger: 'manual' | 'cron' | 'pre_release'
  triggeredBy      String    @default("manual") @map("triggered_by")
  // Scenarios rodados (subset filter aplicado) — null = todos
  scenarioFilter   Json?     @map("scenario_filter")
  // Métricas agregadas
  totalScenarios   Int?      @map("total_scenarios")
  passed           Int?
  partial          Int?
  failed           Int?
  criticalFailed   Int?      @map("critical_failed")
  scorePercent     Int?      @map("score_percent")
  // Resultado completo (todos os ScenarioResult em JSON)
  results          Json?
  // Erro (se status=failed)
  error            String?   @db.Text
  // Timing
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  durationMs       Int?      @map("duration_ms")
  // FASE 2.2a (#243) — instrumentação Slack (diagnóstico de falhas silenciosas)
  // 'skipped' (não cruzou threshold) | 'sent' | 'failed' (com slackAlertError)
  slackAlertStatus String?   @map("slack_alert_status")
  slackAlertError  String?   @map("slack_alert_error") @db.Text
  slackAlertSentAt DateTime? @map("slack_alert_sent_at")

  fixDecisions AgentEvalFixDecision[]

  @@index([agentId, startedAt])
  @@index([status])
  @@map("agent_eval_runs")
}

// FASE 2.2a (#243) — Audit log de decisões de aplicar/recusar sugestões IA.
// Quando admin/cliente clica "Aplicar Sugestão" no dashboard, snapshot do
// prompt antes/depois é persistido aqui pra rollback + audit.
model AgentEvalFixDecision {
  id                 String       @id @default(uuid()) @db.Text
  runId              String       @map("run_id")
  run                AgentEvalRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  scenarioId         String       @map("scenario_id") // ex: cr5_nome_disponivel_usar
  agentId            String       @map("agent_id")
  // 'applied' | 'rejected' | 'reverted'
  decision           String
  // Snapshot da sugestão original (JSONB: summary + patches + confidence)
  originalSuggestion Json?        @map("original_suggestion")
  // Diff final efetivamente aplicado (pode ter sido editado pelo user)
  finalDiff          String?      @map("final_diff") @db.Text
  // Snapshot do system_prompt antes (rollback) e depois
  promptBefore       String?      @map("prompt_before") @db.Text
  promptAfter        String?      @map("prompt_after") @db.Text
  // Audit: quem decidiu
  decidedById        String?      @map("decided_by_id")
  decidedByEmail     String       @map("decided_by_email") // snapshot
  decidedByName      String?      @map("decided_by_name") // snapshot
  decidedByRole      String?      @map("decided_by_role") // SUPERADMIN | ADMIN
  decidedAt          DateTime     @default(now()) @map("decided_at")
  // Motivo opcional (preenche em 'rejected' ou notas em 'applied')
  notes              String?      @db.Text
  // Se reverted, aponta pra decision original
  revertedFromId     String?      @map("reverted_from_id")

  @@index([runId])
  @@index([agentId, decidedAt])
  @@index([scenarioId])
  @@map("agent_eval_fix_decisions")
}

// V2-018 · llm_call_logs (Sprint 0 Blocker 1)
// Audit por turn das chamadas LLM via LLMRouter.
// Não polui audit_logs (hash chain) — ver migration.sql para racional.
// ═══════════════════════════════════════════════════════
model LLMCallLog {
  id                String   @id @default(uuid()) @db.Text
  organizationId    String?  @map("organization_id")
  conversationId    String?  @map("conversation_id")
  provider          String // 'anthropic-sonnet' | 'anthropic-haiku' | 'openai-mini' | 'none'
  model             String // 'claude-sonnet-4-6' | etc
  operation         String   @default("chat") // 'chat' | 'classify' | 'sentiment' | 'extract'
  inputTokens       Int?     @map("input_tokens")
  outputTokens      Int?     @map("output_tokens")
  costUsdEstimate   Decimal? @map("cost_usd_estimate") @db.Decimal(10, 6)
  latencyMs         Int      @map("latency_ms")
  fallbackTriggered Boolean  @default(false) @map("fallback_triggered")
  attemptCount      Int      @default(1) @map("attempt_count")
  error             String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([provider, createdAt])
  @@map("llm_call_logs")
}

// ═══════════════════════════════════════════════════════════
// AGENDAMENTO (2026-07-08) — a IA agenda com o cliente final.
// Agenda interna = fonte da verdade (hub). Calendário externo (Google/Microsoft)
// é espelho que sincroniza bidirecionalmente com a interna.
// ═══════════════════════════════════════════════════════════

enum AppointmentModality {
  in_person
  online
  phone
  video
}

enum AppointmentStatus {
  pending // criado, aguardando confirmação (quando requiresConfirmation)
  confirmed
  cancelled
  no_show
  completed
}

enum AppointmentSource {
  ai // criado pela Iza numa conversa
  manual // criado pelo dono do negócio na agenda interna
  external_sync // veio de um calendário externo conectado
}

enum CalendarProvider {
  google
  microsoft
}

enum CalendarConnectionStatus {
  active
  expired
  revoked
}

// Tipo de agendamento que o dono do negócio oferece (Consulta, Reunião, Visita…).
// Cada tipo carrega as REGRAS que a IA respeita ao agendar.
model AppointmentType {
  id                   String              @id @default(uuid()) @db.Text
  organizationId       String              @map("organization_id")
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  icon                 String?
  durationMin          Int                 @default(30) @map("duration_min")
  durationBookerChoice Boolean             @default(false) @map("duration_booker_choice")
  modality             AppointmentModality @default(online)
  locationText         String?             @map("location_text") // endereço p/ presencial
  meetingLinkTemplate  String?             @map("meeting_link_template") // p/ online/vídeo
  // Grade semanal + fuso: { timezone, weekly: { mon:[["09:00","18:00"]], ... } }
  availability         Json                @default("{}")
  minNoticeMin         Int                 @default(120) @map("min_notice_min")
  bufferBeforeMin      Int                 @default(0) @map("buffer_before_min")
  bufferAfterMin       Int                 @default(0) @map("buffer_after_min")
  maxPerDay            Int?                @map("max_per_day")
  futureHorizonDays    Int                 @default(60) @map("future_horizon_days")
  requiresConfirmation Boolean             @default(false) @map("requires_confirmation")
  // Campos que o cliente final preenche: [{ key, label, type, required }]
  bookingFields        Json                @default("[]") @map("booking_fields")
  // Lembretes: [{ offsetMin, channel }]
  reminders            Json                @default("[]")
  cancelPolicyText     String?             @map("cancel_policy_text")
  active               Boolean             @default(true)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  appointments         Appointment[]

  @@index([organizationId, active])
  @@map("appointment_types")
}

// Um agendamento concreto na agenda interna (hub).
model Appointment {
  id                   String              @id @default(uuid()) @db.Text
  organizationId       String              @map("organization_id")
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointmentTypeId    String?             @map("appointment_type_id")
  appointmentType      AppointmentType?    @relation(fields: [appointmentTypeId], references: [id], onDelete: SetNull)
  contactId            String?             @map("contact_id")
  contact              Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversationId       String?             @map("conversation_id")
  status               AppointmentStatus   @default(pending)
  startAt              DateTime            @map("start_at")
  endAt                DateTime            @map("end_at")
  timezone             String              @default("America/Sao_Paulo")
  modality             AppointmentModality @default(online)
  customerName         String              @map("customer_name")
  customerPhone        String?             @map("customer_phone")
  customerEmail        String?             @map("customer_email")
  answers              Json                @default("{}") // respostas dos bookingFields
  location             String?
  meetingUrl           String?             @map("meeting_url")
  notes                String?
  source               AppointmentSource   @default(ai)
  // Espelho no calendário externo (idempotência de sync)
  externalEventId      String?             @map("external_event_id")
  calendarConnectionId String?             @map("calendar_connection_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([organizationId, startAt])
  @@index([organizationId, status])
  @@index([calendarConnectionId, externalEventId])
  @@map("appointments")
}

// Conexão OAuth/credencial com um calendário externo. Tokens cifrados em repouso.
model CalendarConnection {
  id                   String                   @id @default(uuid()) @db.Text
  organizationId       String                   @map("organization_id")
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider             CalendarProvider
  status               CalendarConnectionStatus @default(active)
  externalAccountEmail String?                  @map("external_account_email")
  accessTokenEnc       String?                  @map("access_token_enc") @db.Text
  refreshTokenEnc      String?                  @map("refresh_token_enc") @db.Text
  tokenExpiresAt       DateTime?                @map("token_expires_at")
  scope                String?
  targetCalendarId     String?                  @map("target_calendar_id")
  // Google watch channel
  channelId            String?                  @map("channel_id")
  resourceId           String?                  @map("resource_id")
  watchExpiresAt       DateTime?                @map("watch_expires_at")
  // Microsoft Graph subscription
  subscriptionId       String?                  @map("subscription_id")
  subExpiresAt         DateTime?                @map("sub_expires_at")
  // Sync incremental (Google syncToken / Graph deltaLink)
  syncToken            String?                  @map("sync_token") @db.Text
  deltaLink            String?                  @map("delta_link") @db.Text
  lastSyncAt           DateTime?                @map("last_sync_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  @@index([organizationId, provider])
  @@map("calendar_connections")
}

// ═══════════════════════════════════════════════════════
// Cupons de desconto emitidos pelo SUPERADMIN (2026-07-08)
// ═══════════════════════════════════════════════════════
// Cada cupom é RESTRITO a um Stripe Product (applies_to.products) e de USO
// ÚNICO (max_redemptions=1). Espelho local do par Coupon+PromotionCode do
// Stripe, para a tela de emissão/auditoria. A verdade do resgate é o Stripe
// (times_redeemed sincronizado ao listar). Emissão só via /admin/coupons.
model DiscountCoupon {
  id                    String   @id @default(cuid())
  code                  String   @unique // código legível digitado no checkout
  stripeCouponId        String   @map("stripe_coupon_id")
  stripePromotionCodeId String   @map("stripe_promotion_code_id")
  productId             String   @map("product_id") // prod_… (Stripe)
  productKey            String   @map("product_key") // GROWTH, AGENT_SEAT…
  productLabel          String   @map("product_label")
  percentOff            Int      @map("percent_off")
  duration              String // once | repeating | forever
  durationInMonths      Int?     @map("duration_in_months")
  createdByEmail        String   @map("created_by_email")
  timesRedeemed         Int      @default(0) @map("times_redeemed")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([productKey])
  @@map("discount_coupons")
}

// ═══════════════════════════════════════════════════════════════════
// MIRA PROSPECTS — inteligência e qualificação de oportunidades
// -------------------------------------------------------------------
// Add-on pago (Growth+; incluído em Business/Enterprise). Fonte
// comercial: packages/shared/src/miraEntitlement.ts. Todas as tabelas
// são POR TENANT (organizationId). O Alvo é a unidade de valor: só
// conta na cota quando passa o gate de qualidade (status READY+).
// contactId/dealId são ids "soltos" de propósito (pouso no CRM sem
// acoplar cascade aos modelos quentes Contact/Deal).
// LGPD: dado de PF (MiraDecisor) carrega fonte/baseLegal/lineage.
// ═══════════════════════════════════════════════════════════════════

enum MiraAlvoStatus {
  DISCOVERED // candidato achado (Motor A ou B), ainda cru
  QUALIFYING // agentes trabalhando / re-mapeamento em loop
  READY // passou o gate de qualidade — CONTA NA COTA
  DELIVERED // entregue (pousou no CRM e/ou saiu em relatório)
  ARCHIVED // descartado (fora do ICP, duplicado, pedido do cliente)
}

enum MiraAlvoKind {
  B2B // pessoa jurídica (CNPJ)
  B2C // pessoa física / negócio local
}

enum MiraMotor {
  BASE_INSTALADA // Motor A — carteira/CRM do cliente
  DESCOBERTA // Motor B — net-new (CNPJ/Places)
}

// Perfil de Prospecção (ICP) — 1 por org. Gerado pelo survey do módulo
// (Motor 0), reaproveitando o contexto do Treinar IA quando existir.
/// O "Motor 0": o que a org vende e para quem quer vender. União
/// discriminada por tipoCliente — os campos de alvo B2B e B2C não se
/// misturam no mesmo nível, porque quase nada de um vale para o outro.
model MiraPerfil {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Discriminador: decide se vale alvoB2B ou alvoB2C.
  tipoCliente MiraAlvoKind @default(B2B)

  // ── Seu negócio ─────────────────────────────────────────────────
  // Chega pronto do cadastro (settings.segmento/subsegmentos), editável.
  segmento     String?
  subsegmentos String[] @default([])

  // ── Comum: vale nos dois caminhos ───────────────────────────────
  catalogo            Json     @default("[]") // [{nome, descricao}]
  doresResolvidas     String[] @default([])
  resultadosEsperados String[] @default([])
  casosDeUso          String[] @default([])
  diferenciais        String[] @default([])
  concorrentes        String[] @default([])
  ticketMedio         String? // faixa livre ("R$ 5k–15k/mês"), não número

  // ── Alvo: condicional ───────────────────────────────────────────
  // Só o do tipoCliente vale. Guardamos os dois para o cliente não
  // perder o que digitou ao alternar entre B2B e B2C.
  /// {cnaesAlvo[], portes[], regioes[], faturamentoAnual?, numFuncionarios?,
  /// technographics[], sinaisIntencao[], decisor[], influenciadores[],
  /// usuarioFinal[], objecoes?, cicloVenda?, redFlagsB2B[], mustHavesB2B[],
  /// clientesReferencia[]}
  alvoB2B Json @default("{}")
  /// {faixaEtaria?, genero?, faixaRenda?, ocupacao[], composicaoFamiliar[],
  /// regiaoCidade[], tipoRegiao[], interesses[], canais[], habitosConsumo[],
  /// momentoDeVida[], doresDesejos[], capacidadePagamento?, redFlagsB2C[],
  /// influenciadoresB2C[]}
  alvoB2C Json @default("{}")

  /// Prontidão (0-100). Abaixo de 60 os motores não largam.
  prontidao Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mira_perfis")
}

// O Alvo — conta qualificada com dossiê. Unidade de valor e de cota.
enum MiraCampanhaStatus {
  EM_ANDAMENTO
  CONCLUIDA
  FALHOU
}

/// Campanha de prospecção: um disparo NOMEADO dos motores. Agrupa os Alvos
/// que ele criou e guarda parâmetros e resultado para a gestão no hub. Não
/// confundir com as Campanhas do Zap Impulso (disparo de mensagens): aqui é
/// mapeamento de mercado.
model MiraCampanha {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nome           String
  /// BASE_INSTALADA = mapear carteira (CNPJs); DESCOBERTA = descobrir novos.
  tipo           MiraMotor
  status         MiraCampanhaStatus @default(EM_ANDAMENTO)
  /// O que foi pedido: {consulta?, regiao?, kind?, cnpjs? (quantidade)}
  parametros     Json               @default("{}")
  /// O que voltou: {encontrados?, criados?, prontos?, duplicados?, regiaoAplicada?, regiaoOrigem?, motivo?}
  resultado      Json               @default("{}")
  alvos          MiraAlvo[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, createdAt])
  @@map("mira_campanhas")
}

model MiraAlvo {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           MiraAlvoKind   @default(B2B)
  motor          MiraMotor
  status         MiraAlvoStatus @default(DISCOVERED)

  /// Campanha que criou este Alvo (null nos antigos e nos criados fora de campanha).
  campanhaId String?
  campanha   MiraCampanha? @relation(fields: [campanhaId], references: [id], onDelete: SetNull)

  // Identificação da conta-alvo
  nome              String // razão social / nome do negócio
  nomeFantasia      String?
  cnpj              String? // B2B (dado público de PJ)
  cnae              String?
  porte             String? // MEI/ME/EPP/DEMAIS + regime quando conhecido
  capitalSocial     Float? // capital social declarado (R$) — porte real por empresa (registro público)
  situacaoCadastral String?
  municipio         String?
  uf                String?
  site              String?
  telefone          String? // contato público (Receita no B2B, Places no B2C) — o gate do Motor B exige telefone OU site
  placeId           String? // Google Places (negócio local)

  // Dossiê (blocos 1:1 como campos/JSON; 1:N em tabelas próprias)
  miraScore       Int? // 0-100 (null até o gate)
  scoreBreakdown  Json? // {fatores: [{nome, peso, valor, motivo}]}
  confianca       Int? // 0-100 — completude/verificação do dossiê
  resumo          String? @db.Text // parágrafo executivo do Alvo
  janelaEntrada   Json? // {gatilho, momento, urgencia, evidencia}
  processoCompras Json? // {modo, cicloOrcamentario, cadeiaAprovacao, fontes[]}
  whiteSpace      Json? // Motor A: {jaCompra[], oportunidades[]} (catálogo x conta)
  /// Plano de ação imediato sugerido pela IA: o próximo passo concreto neste
  /// Alvo. Vira Task PENDING em /tasks (ver planoAcao.ts). Texto, não Json:
  /// é uma instrução para uma pessoa ler e executar, não um objeto.
  planoAcao       String? @db.Text
  /// Task gerada a partir do plano de ação (id solto, como contactId/dealId).
  /// Evita duplicar tarefa a cada Aprofundar e liga a conclusão de volta ao Alvo.
  planoAcaoTaskId String?

  // Pouso no CRM (ids soltos, sem cascade — ver cabeçalho da seção)
  contactId String?
  dealId    String?

  // Cota/telemetria
  countedInQuota Boolean @default(false) // virou READY e descontou cota
  quotaMonth     String? // 'YYYY-MM' em que consumiu cota
  custoCreditos  Int     @default(0) // custo de enriquecimento acumulado
  fontes         Json    @default("[]") // [{campo, url, data, confianca}] — lineage agregado

  decisores     MiraDecisor[]
  demandas      MiraDemanda[]
  oportunidades MiraOportunidade[]
  incumbentes   MiraIncumbente[]
  releases      MiraRelease[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, cnpj]) // dedup B2B por org (null permite múltiplos B2C)
  @@index([organizationId, status])
  @@index([organizationId, miraScore])
  @@index([organizationId, quotaMonth])
  @@index([campanhaId])
  @@map("mira_alvos")
}

// Comitê de compra — decisores nominais por papel (dado de PF: lineage!)
model MiraDecisor {
  id            String   @id @default(cuid())
  alvoId        String
  alvo          MiraAlvo @relation(fields: [alvoId], references: [id], onDelete: Cascade)
  nome          String
  papel         String // papel no ICP do cliente (ex.: 'Diretor de TI', 'CISO')
  arquetipo     String? // CHAMPION | ECONOMIC_BUYER | TECHNICAL_BUYER | USER | LEGAL_PROCUREMENT | EXEC_SPONSOR
  senioridade   String?
  isChampion    Boolean  @default(false)
  vinculoQsa    Boolean  @default(false) // veio do quadro societário (fonte oficial)
  contato       Json? // {email?, phone?, whatsapp?} — só de fonte lícita
  perfilPublico Json? // {temas[], estilo, ganchos[], fontes[]} — pegada pública
  fonte         String? // origem principal (url)
  baseLegal     String   @default("legitimo_interesse") // LGPD
  lineage       Json     @default("[]") // [{campo, url, data}]
  confianca     Int      @default(0) // 0-100 (2+ fontes = alta)
  contactId     String? // pouso em Contact (id solto)
  createdAt     DateTime @default(now())

  @@index([alvoId])
  @@map("mira_decisores")
}

// Demandas recentes da conta (nº1 e nº2, com evidência)
model MiraDemanda {
  id        String        @id @default(cuid())
  alvoId    String
  alvo      MiraAlvo      @relation(fields: [alvoId], references: [id], onDelete: Cascade)
  rank      Int // 1 | 2
  descricao String        @db.Text
  evidencia String?       @db.Text
  fonte     String? // url
  dataFonte DateTime?
  confianca Int           @default(0)
  createdAt DateTime      @default(now())
  // A matéria que evidenciou esta demanda (quando nasceu de um release)
  releases  MiraRelease[]

  @@index([alvoId, rank])
  @@map("mira_demandas")
}

// Oportunidades de portfólio (demanda x catálogo do cliente)
model MiraOportunidade {
  id            String   @id @default(cuid())
  alvoId        String
  alvo          MiraAlvo @relation(fields: [alvoId], references: [id], onDelete: Cascade)
  rank          Int // 1 | 2
  produto       String // item do catálogo do MiraPerfil
  demandaRank   Int? // qual demanda ela resolve (1|2)
  racional      String   @db.Text
  valorEstimado Decimal?
  roteiro       Json? // {porSponsor: [{decisorId, mensagem, canal}]} — Abordagem/SPICED
  // ANALISE = presunção da Fase 1 (é substituída a cada "Aprofundar com IA").
  // RELEASE = nasceu de um fato publicado com fonte; sobrevive ao re-aprofundar,
  // senão o próximo clique apagaria a oportunidade que a matéria gerou.
  origem        String   @default("ANALISE")
  fonte         String? // url da matéria que originou (quando origem = RELEASE)
  createdAt     DateTime @default(now())

  @@index([alvoId, rank])
  @@map("mira_oportunidades")
}

// Fornecedores incumbentes na conta
model MiraIncumbente {
  id              String   @id @default(cuid())
  alvoId          String
  alvo            MiraAlvo @relation(fields: [alvoId], references: [id], onDelete: Cascade)
  fornecedor      String
  categoria       String?
  evidencia       String?  @db.Text
  fonte           String?
  deslocabilidade String? // ALTA | MEDIA | BAIXA + motivo curto
  createdAt       DateTime @default(now())

  @@index([alvoId])
  @@map("mira_incumbentes")
}

// Releases dos Alvos — monitoramento semanal (cron) das contas entregues
model MiraRelease {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alvoId             String
  alvo               MiraAlvo     @relation(fields: [alvoId], references: [id], onDelete: Cascade)
  titulo             String
  resumo             String       @db.Text
  url                String?
  // Data em que a matéria/post foi PUBLICADO (não a data em que achamos).
  // Só é preenchida quando aparece na própria fonte e passa no verificador.
  dataPublicacao     DateTime?
  // Por que é relevante para as ofertas DESTE cliente + gancho de abordagem
  relevancia         String       @db.Text
  anguloAbordagem    String?      @db.Text
  produtoRelacionado String? // item do catálogo com sinergia
  // A demanda que ESTE fato evidenciou. Sem a FK, o dossiê não consegue dizer
  // "esta demanda nasceu desta matéria" — era só string solta antes.
  demandaId          String?
  demanda            MiraDemanda? @relation(fields: [demandaId], references: [id], onDelete: SetNull)
  confianca          Int          @default(0)
  lida               Boolean      @default(false)
  // Quando o cliente foi sinalizado (Task criada). Null = ainda não avisamos.
  alertadoEm         DateTime?
  createdAt          DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([alvoId])
  @@index([demandaId])
  @@map("mira_releases")
}

// Ledger mensal de cota (used = Alvos READY no mês; packExtra = packs one-shot)
model MiraUsageMonthly {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monthKey       String // 'YYYY-MM'
  used           Int          @default(0)
  packExtra      Int          @default(0) // alvos extras comprados NESTE mês (não acumula)
  packPurchases  Json         @default("[]") // [{pack, alvos, priceBrl, stripeRef?, at}]
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  @@unique([organizationId, monthKey])
  @@map("mira_usage_monthly")
}

// Índice local da base aberta de CNPJ (Receita Federal) — tabela
// COMPARTILHADA da plataforma (não é dado de tenant, é registro público),
// por isso SEM organizationId/RLS. Alimentada pelo job de ingestão
// (scripts/ingest-cnpj-base.ts, rodado no servidor via .command).
// Só guarda o mínimo pra achar candidato por CNAE/UF/situação; firmografia
// completa, QSA e decisores continuam vindo do enriquecimento por CNPJ
// (Receita/BrasilAPI) já existente, alvo por alvo — nunca duplicado aqui.
model MiraCnpjIndex {
  cnpj              String   @id // 14 dígitos
  razaoSocial       String?
  nomeFantasia      String?
  cnae              String?
  situacaoCadastral String? // ATIVA | BAIXADA | SUSPENSA | INAPTA | NULA
  municipio         String?
  uf                String?
  atualizadoEm      DateTime @updatedAt

  @@index([cnae, uf, situacaoCadastral])
  @@index([uf, situacaoCadastral])
  @@map("mira_cnpj_index")
}

// Log de enriquecimento (telemetria de match rate e custo por fonte)
model MiraEnriquecimentoLog {
  id             String   @id @default(cuid())
  organizationId String
  alvoId         String?
  fonte          String // 'cnpj_receita' | 'places' | provedor licenciado
  tipo           String // 'firmografia' | 'email' | 'phone' | 'news' | ...
  resultado      String // 'valido' | 'nao_encontrado' | 'erro'
  custoCreditos  Int      @default(0)
  latenciaMs     Int?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([fonte, resultado])
  @@map("mira_enriquecimento_log")
}
