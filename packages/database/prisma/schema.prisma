generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector, uuidOssp(map: "uuid-ossp")]
}

// ═══════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════

enum PlanType {
  STARTER
  GROWTH
  SCALE
  BUSINESS
  ENTERPRISE
}

enum UserRole {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  AGENT
  AUDITOR
}

enum ConversationStatus {
  OPEN
  WAITING
  ASSIGNED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
  INTERACTIVE
  LOCATION
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum CampaignType {
  BROADCAST
  TRIGGER
  SEQUENCE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED
}

enum FlowTriggerType {
  KEYWORD
  FIRST_CONTACT
  SCHEDULE
  MANUAL
  EVENT
  // Adicionados em 2026-05-28 pra cobrir os templates Maestro V1
  CUSTOM
  CART_ABANDONED
  TIMEOUT_24H
  TIMEOUT_48H
  TIMEOUT_14D
  TIMEOUT_30D
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

// LGPD Art. 7 + Art. 11 — bases legais de tratamento
enum LegalBasis {
  CONSENT // Art. 7, I / Art. 11, I
  CONTRACT // Art. 7, V
  LEGAL_OBLIGATION // Art. 7, II
  LEGITIMATE_INTEREST // Art. 7, IX
  VITAL_INTERESTS // Art. 7, VII
  PUBLIC_INTEREST // Art. 7, III
  CREDIT_PROTECTION // Art. 7, X
  HEALTH_PROTECTION // Art. 11, II, f
}

// Tipos de requisição do titular — LGPD Art. 18
enum DataSubjectRequestType {
  ACCESS // confirmação + acesso
  CORRECTION // correção
  ANONYMIZATION // anonimização
  PORTABILITY // portabilidade
  DELETION // eliminação
  CONSENT_REVOKE // revogação de consentimento
  INFORMATION // informação sobre compartilhamento
}

enum DataSubjectRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  EXPIRED
}

// ═══════════════════════════════════════════════════════
// MODELS
// ═══════════════════════════════════════════════════════

model Organization {
  id                        String   @id @default(cuid())
  name                      String
  slug                      String   @unique
  plan                      PlanType @default(STARTER)
  // @unique: o webhook de entrada roteia a mensagem do lead para a org dona
  // deste phone_number_id. Sem unicidade, duas orgs podiam registrar o mesmo
  // id e o roteamento (findFirst) mandava o lead pra org errada (14/07/2026).
  // Postgres permite múltiplos NULL num unique, então orgs sem canal seguem ok.
  whatsappPhoneNumberId     String?  @unique
  whatsappBusinessAccountId String?
  whatsappAccessToken       String?
  // FASE 4 (#251) — Instagram Direct Messaging via Meta Graph API.
  // instagramAccountId: ID da IG Business Account (ex: 17841...)
  // instagramPageId: Facebook Page ID linkada à conta IG (necessária pelo Meta)
  // instagramAccessToken: Page Access Token de longa duração (60 dias, renovável)
  instagramAccountId        String?  @unique @map("instagram_account_id")
  instagramPageId           String?  @map("instagram_page_id")
  instagramAccessToken      String?  @map("instagram_access_token") @db.Text
  // Self-serve "traga seu token": app secret do app Meta DO CLIENTE, usado pra
  // verificar a assinatura (x-hub-signature-256) dos webhooks WA/IG que chegam
  // assinados pelo app dele. Sem isso (ex.: Iza, ou cliente sob o app da ZappIQ)
  // o webhook cai no META_APP_SECRET global. Ver [[canais-self-serve-token-por-org]].
  metaAppSecret             String?  @map("meta_app_secret")
  settings                  Json     @default("{}")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // LGPD — retenção customizável por organização (dias).
  // Default conservador: 1825d (5 anos) audit / 730d (2 anos) soft-deleted.
  auditRetentionDays      Int     @default(1825)
  softDeleteRetentionDays Int     @default(730)
  dpoEmail                String? // Art. 41 — contato do encarregado

  // ── Trial (14 dias com cap de custo LLM) ────────────────
  // trialStartedAt/trialEndsAt: janela do período grátis.
  // trialCostCapUsd: teto de LLM que o tenant pode queimar no trial
  // para não impactar margem em signups curiosos/abusivos.
  // trialConverted: marca que o trial virou assinatura paga.
  trialStartedAt  DateTime?
  trialEndsAt     DateTime?
  trialCostCapUsd Float     @default(15.00)
  trialConverted  Boolean   @default(false)
  isTrialActive   Boolean   @default(true)

  // ── Billing cycle sinc com Stripe ───────────────────────
  billingCycle       String? // "monthly" | "annual"
  subscriptionStatus String? // active | past_due | canceled | trialing

  // ── Ciclo de vida canônico (Área Clientes / Fase 1) ─────
  // Colunas aditivas nullable. Antes só existiam no settings JSON — promovidas
  // para colunas dedicadas para poder filtrar/ordenar e derivar lifecycleStage
  // sem ler JSON. stripeCustomerId/stripeSubscriptionId aqui são a fonte real
  // de "conta pagante" (nunca trialConverted). Preenchidas pelo webhook Stripe
  // (Fase 3) e pelo backfill; hoje nascem NULL.
  paidAt                DateTime? // 1º pagamento confirmado
  churnedAt             DateTime? // cancelamento efetivo (subscription.deleted)
  cardAddedAt           DateTime? // cartão adicionado (setup intent ok)
  stripeCustomerId      String? // cus_...
  stripeSubscriptionId  String? // sub_... — ÂNCORA de ACTIVE
  // Cache do estágio derivado por deriveLifecycleStage() (recomputado em cron
  // diário + webhooks). Materializado para consulta rápida; a verdade continua
  // sendo a função pura. crm_accounts.lifecycleStage é o espelho consumido pela UI.
  accountLifecycleStage String?
  // Fim da carência de paywall. Setado APENAS nas orgs já vencidas no go-live do
  // gate (cortesia de migração de 7 dias). Go-forward = null (trava dura no T-0).
  paywallGraceUntil     DateTime?
  // Troca de plano AGENDADA (downgrade / anual travado). { plan, cycle, effectiveAt }.
  // Escrito ao agendar (Subscription Schedule no Stripe); limpo quando o webhook
  // aplica a fase 2 na renovação OU quando o cliente cancela o agendamento.
  pendingPlanChange     Json?

  users                   User[]
  contacts                Contact[]
  conversations           Conversation[]
  campaigns               Campaign[]
  flows                   Flow[]
  knowledgeBases          KnowledgeBase[]
  agents                  Agent[] // V2-021 (Sprint 0 §11.3)
  templates               MessageTemplate[]
  dataSubjectRequests     DataSubjectRequest[]
  tenantUsageMonthly      TenantUsageMonthly[]
  qaPairs                 QAPair[]
  onboardingJourneyStates OnboardingJourneyState[] // FASE 1.B task #240
  // CRM sinérgico (Onda 0): pipeline, timeline de atividades e tarefas por org.
  pipelineStages          PipelineStage[]
  activities              Activity[]
  tasks                   Task[]
  taskTags                TaskTag[]
  flowNodeStats           FlowNodeStat[]
  campaignVariants        CampaignVariant[] // Impulso — braços de bandit
  campaignNodeStats       CampaignNodeStat[] // Impulso — funil por nó
  campaignAttributions    CampaignAttribution[] // Impulso — atribuição ad->venda
  campaignConsents        CampaignConsent[] // Impulso — trilha de consentimento LGPD
  analyticsMetricsDaily   AnalyticsMetricDaily[] // Fase 2 Pulso — snapshots diários
  analyticsInsights       AnalyticsInsight[] // Fase 2 Pulso — narrativas/anomalias
  crmAccount              CrmAccount? // Área Clientes — espelho de conta (1:1 opcional)
  stripeInvoices          StripeInvoice[] // Área Clientes Fase 3 — faturas Stripe persistidas
  appointmentTypes        AppointmentType[] // Agendamento — tipos oferecidos pela IA
  appointments            Appointment[] // Agendamento — agenda interna (hub)
  calendarConnections     CalendarConnection[] // Agendamento — Google/Microsoft conectados
  // Mira Prospects — inteligência de oportunidades (add-on)
  miraPerfil              MiraPerfil?
  miraAlvos               MiraAlvo[]
  miraCampanhas           MiraCampanha[]
  miraReleases            MiraRelease[]
  miraUsageMonthly        MiraUsageMonthly[]

  // ── Self-service AI training (maturação da IA pelo próprio cliente) ──
  // Score 0-100 cacheado. Atualizado a cada mutação relevante (upload de doc,
  // criação de Q&A, preenchimento de survey). Exposto no dashboard como
  // "termômetro" guiando o cliente ao próximo passo de qualificação da IA.
  aiReadinessScore     Int       @default(0)
  aiReadinessUpdatedAt DateTime?
  // Data em que o cliente finalizou a configuração inicial recomendada
  // (survey mínimo + 1 doc/URL + 3 Q&As). Marco usado para campanhas de
  // ativação e para o NPS do onboarding.
  aiTrainingReadyAt    DateTime?

  @@map("organizations")
}

// ═══════════════════════════════════════════════════════════
// CrmAccount — espelho de conta da Área Clientes (plataforma, NÃO por tenant)
// -----------------------------------------------------------
// 1 linha por org OU por signup (signup pré-org tem organizationId NULL).
// Fonte da verdade do CRM de plataforma. lifecycleStage é materializado por
// deriveLifecycleStage() (Fase 1) e recomputado no cron diário + webhooks.
// Sem RLS por tenant: é a base instalada da ZappIQ, gerida pelo Superadmin.
// ═══════════════════════════════════════════════════════════
model CrmAccount {
  id             String        @id @default(cuid())
  // 1:1 opcional com a org. Único quando presente (índice parcial no SQL).
  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  // Elo com a linha em signups (tabela fora do Prisma). Guardado como texto.
  signupId       String?
  email          String
  company        String?
  cnpj           String?
  plan           String?
  // NOVO | EM_TRIAL | TRIAL | ATIVO | ACTIVE | TRIAL_EXPIRADO | TRIAL_EXPIRED |
  // PAGO | PAST_DUE | CHURNED — ver accountLifecycle.ts (valores canônicos EN).
  lifecycleStage String        @default("NOVO")
  ownerUserId    String? // usuário ZappIQ dono da conta (SDR/CS)
  mrrCents       Int           @default(0)
  healthScore    Int? // 0-100 (health v1 composto)
  trialEndsAt    DateTime?
  lastActivityAt DateTime?
  pqlScore       Int? // Fase 4 (PLG) — nasce NULL
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  activities CrmAccountActivity[]

  @@index([email])
  @@index([lifecycleStage])
  @@index([signupId])
  @@map("crm_accounts")
}

// ═══════════════════════════════════════════════════════════
// CrmAccountActivity — timeline da conta (reusa padrão Activity/ActivityType)
// ═══════════════════════════════════════════════════════════
model CrmAccountActivity {
  id           String     @id @default(cuid())
  crmAccountId String
  crmAccount   CrmAccount @relation(fields: [crmAccountId], references: [id], onDelete: Cascade)
  type         String // ex: 'lifecycle_change' | 'owner_assigned' | 'note'
  payload      Json?
  createdAt    DateTime   @default(now())

  @@index([crmAccountId, createdAt])
  @@map("crm_account_activity")
}

// ═══════════════════════════════════════════════════════════
// StripeInvoice — fatura Stripe persistida pelo webhook (Área Clientes / Fase 3)
// -----------------------------------------------------------
// 1 linha por invoice.paid / invoice.payment_succeeded. Tabela de PLATAFORMA
// (faturamento da ZappIQ, gerida pelo Superadmin — sem RLS por tenant).
// stripeInvoiceId é único → idempotência natural de reentrega de evento.
// amountBrlCents = amount_paid do Stripe (centavos de BRL).
// ═══════════════════════════════════════════════════════════
model StripeInvoice {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeInvoiceId String       @unique
  amountBrlCents  Int          @default(0)
  status          String // 'paid' | 'open' | 'void' | ...
  periodStart     DateTime?
  periodEnd       DateTime?
  paidAt          DateTime?
  createdAt       DateTime     @default(now())

  @@index([organizationId, paidAt])
  @@map("stripe_invoices")
}

// ═══════════════════════════════════════════════════════════
// StripeWebhookEvent — idempotência por event id (Área Clientes / Fase 3)
// -----------------------------------------------------------
// Presença da linha = evento já processado. Evita dupla-gravação em reentrega.
// Tabela de plataforma, sem RLS por tenant.
// ═══════════════════════════════════════════════════════════
model StripeWebhookEvent {
  id          String   @id // evt_... (id do evento do Stripe)
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_webhook_events")
}

// ═══════════════════════════════════════════════════════════
// TenantUsageMonthly — H10 unit economics por tenant
// Agregado denormalizado atualizado por job diário.
// Permite responder "esse cliente dá lucro?" em milissegundos.
// ═══════════════════════════════════════════════════════════
model TenantUsageMonthly {
  id                         String       @id @default(cuid())
  organizationId             String
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Janela mensal no formato YYYY-MM (ex: "2026-04").
  periodYearMonth            String
  // Consumo bruto observado.
  llmCostUsd                 Float        @default(0)
  llmInputTokens             BigInt       @default(0)
  llmOutputTokens            BigInt       @default(0)
  aiMessagesProcessed        Int          @default(0)
  broadcastsSent             Int          @default(0)
  conversationsOpened        Int          @default(0)
  conversationsClosed        Int          @default(0)
  conversationsAiResolved    Int          @default(0)
  conversationsHumanResolved Int          @default(0)
  handoffsCount              Int          @default(0)
  // Receita reconhecida no período (derivada do plano × cycle).
  revenueBrlCents            Int          @default(0)
  // Custo da infra atribuído ao tenant (fly/supabase/loki) — rateio proporcional.
  infraCostUsd               Float        @default(0)
  // Gross margin derivada = (revenue - llmCost - infraCost) / revenue.
  grossMarginPercent         Float?
  computedAt                 DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  @@unique([organizationId, periodYearMonth])
  @@index([periodYearMonth])
  @@map("tenant_usage_monthly")
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  name                  String
  passwordHash          String
  role                  UserRole       @default(AGENT)
  avatar                String?
  isOnline              Boolean        @default(false)
  maxConcurrentChats    Int            @default(5)
  organizationId        String
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]
  assignedTasks         Task[]         @relation("AssignedTasks")
  deletedConversations  Conversation[] @relation("DeletedConversations")
  messages              Message[]
  auditLogs             AuditLog[]
  createdAt             DateTime       @default(now())

  @@index([organizationId])
  @@map("users")
}

model Contact {
  id                 String         @id @default(cuid())
  whatsappId         String
  // FASE 4 (#251): IGSID — Instagram-Scoped ID que Meta retorna na DM.
  // É um ID estável por usuário POR conta IG Business (não global).
  // Permite identificar/dedup contato que mandou DM sem precisar do username.
  instagramScopedId  String?        @map("instagram_scoped_id")
  phone              String
  name               String?
  email              String?
  company            String?
  avatarUrl          String?
  tags               String[]       @default([])
  customFields       Json           @default("{}")
  leadScore          Int            @default(0)
  leadStatus         LeadStatus     @default(NEW)
  funnelStage        String         @default("new")
  birthDate          DateTime?
  lastInteractionAt  DateTime?
  consentMarketing   Boolean        @default(false)
  consentMarketingAt DateTime?
  // CRM (Onda 0): atribuição de origem (campanha que originou) + first/last touch.
  sourceCampaignId   String?
  firstTouchAt       DateTime?
  lastTouchAt        DateTime?
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  deals              Deal[]
  activities         Activity[]
  tasks              Task[]
  appointments       Appointment[] // Agendamento — agendamentos deste contato
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([whatsappId, organizationId])
  @@unique([instagramScopedId, organizationId], name: "instagramScopedId_organizationId")
  @@index([organizationId])
  @@index([phone])
  @@index([leadStatus])
  @@map("contacts")
}

model Conversation {
  id               String             @id @default(cuid())
  status           ConversationStatus @default(OPEN)
  channel          String             @default("whatsapp")
  sentiment        Sentiment?
  urgency          Urgency?
  summary          String?
  csatScore        Int?
  assignedToId     String?
  assignedTo       User?              @relation(fields: [assignedToId], references: [id])
  // W3.4 — quando um humano assume a conversa (responde ou é atribuído), a IA
  // fica pausada NESTA conversa: Iza não gera autoreply enquanto for true.
  // Fonte de verdade durável; o cache ai_paused continua como fast-path espelhado.
  aiPaused         Boolean            @default(false)
  contactId        String
  contact          Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages         Message[]
  sourceDeals      Deal[]             @relation("DealSourceConversation")
  internalNotes    InternalNote[]
  activities       Activity[]
  tasks            Task[]
  currentFlowState Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  closedAt         DateTime?
  deletedAt        DateTime? // LGPD Art. 16 — marcação de exclusão
  deletedById      String?
  deletedBy        User?              @relation("DeletedConversations", fields: [deletedById], references: [id])
  deletionReason   String? // motivo (DSR, operacional, purge por retenção)
  anonymizedAt     DateTime? // LGPD Art. 12 — anonimização de PII

  @@index([organizationId])
  @@index([contactId])
  @@index([status])
  @@index([assignedToId])
  @@index([deletedAt])
  @@map("conversations")
}

model Message {
  id                String           @id @default(cuid())
  whatsappMessageId String?          @unique
  // FASE 4 (#251): ID externo do canal (Instagram, futuramente outros).
  // Permite dedup de inbound + correlação de status callbacks.
  // Polimórfico: vale pra IG hoje, web chat session-msg amanhã.
  externalMessageId String?          @unique @map("external_message_id")
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  content           String
  mediaUrl          String?
  mediaType         String?
  templateName      String?
  status            MessageStatus    @default(SENT)
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId          String?
  sender            User?            @relation(fields: [senderId], references: [id])
  isFromBot         Boolean          @default(false)
  aiConfidence      Float?
  metadata          Json?
  // W2.4 — vínculo da mensagem OUTBOUND com a campanha que a originou.
  // ON DELETE SET NULL: apagar a campanha preserva o histórico de mensagens.
  campaignId        String?
  campaign          Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@index([campaignId])
  @@map("messages")
}

model Campaign {
  id             String           @id @default(cuid())
  name           String
  type           CampaignType
  status         CampaignStatus   @default(DRAFT)
  templateId     String?
  template       MessageTemplate? @relation(fields: [templateId], references: [id])
  audienceFilter Json
  scheduledAt    DateTime?
  sentCount      Int              @default(0)
  deliveredCount Int              @default(0)
  readCount      Int              @default(0)
  repliedCount   Int              @default(0)
  failedCount    Int              @default(0)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  // ── Impulso (add-on de campanhas premium, 2026-07-06) — campos ADITIVOS.
  // Campanhas legadas continuam com objective=null / isImpulso=false.
  isImpulso       Boolean               @default(false)
  objective       String? // objetivo em linguagem natural (Iza Estrategista)
  channels        Json? // ['whatsapp','email','sms','instagram']
  autonomyLevel   Int                   @default(2) // 0..4 — padrão 2 (Co-Piloto)
  journey         Json? // nodes/edges (motor Maestro) p/ TRIGGER/SEQUENCE
  audienceSegment Json? // segmento resolvido (além do audienceFilter legado)
  budgetPlan      Json? // plano meta->verba do Copiloto & Coach
  optimization    Json? // config de bandit/otimização
  message         Json? // copy por canal editável pelo cliente: { whatsapp?, instagram?, email?, sms? }
  variants        CampaignVariant[]
  nodeStats       CampaignNodeStat[]
  attributions    CampaignAttribution[]
  consents        CampaignConsent[]
  tasks           Task[]

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, isImpulso])
  @@map("campaigns")
}

/// Impulso — braço de teste (multi-armed bandit) de uma campanha. Volume desloca para a variante vencedora.
model CampaignVariant {
  id             String       @id @default(cuid())
  campaignId     String
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  content        Json // copy/template/criativo da variante
  weight         Float        @default(0.5) // fração do tráfego (bandit atualiza)
  sentCount      Int          @default(0)
  conversions    Int          @default(0)
  revenueCents   Int          @default(0)
  isWinner       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([campaignId])
  @@index([organizationId])
  @@map("campaign_variants")
}

/// Impulso — funil por nó da jornada (drop-off), espelho do FlowNodeStat para campanhas.
model CampaignNodeStat {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  nodeId         String
  nodeType       String
  nodeLabel      String?
  period         String // 'YYYY-MM-DD' UTC
  entries        Int          @default(0)
  ends           Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([campaignId, nodeId, period])
  @@index([organizationId, campaignId])
  @@map("campaign_node_stats")
}

/// Impulso — atribuição anúncio->conversa->venda. Fecha o loop com Meta/TikTok (CAPI/Events) e a janela FEP 72h.
model CampaignAttribution {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contactId       String?
  source          String // 'ctwa' | 'meta_lead_ad' | 'tiktok_msg_ad' | 'organic'
  ctwaClid        String? // click id do Click-to-WhatsApp
  bsuid           String? // Business-Scoped User ID (WhatsApp usernames)
  metaCampaignId  String?
  adId            String?
  fepWindowEndsAt DateTime? // fim da janela FEP 72h (mensagens grátis)
  converted       Boolean      @default(false)
  revenueCents    Int          @default(0)
  convertedAt     DateTime?
  capiSentAt      DateTime? // conversão devolvida ao Meta/TikTok (CAPI/Events)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, campaignId])
  @@index([bsuid])
  @@index([ctwaClid])
  @@map("campaign_attributions")
}

/// Impulso — trilha de consentimento LGPD por contato/campanha (base legal auditável).
model CampaignConsent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contactId      String
  legalBasis     LegalBasis   @default(CONSENT)
  optIn          Boolean      @default(false)
  optInAt        DateTime?
  optOutAt       DateTime?
  source         String? // onde o opt-in foi coletado
  createdAt      DateTime     @default(now())

  @@index([organizationId, contactId])
  @@map("campaign_consents")
}

model Flow {
  id             String          @id @default(cuid())
  name           String
  description    String?
  nodes          Json
  edges          Json
  isActive       Boolean         @default(false)
  version        Int             @default(1)
  priority       Int             @default(0)
  triggerType    FlowTriggerType
  triggerConfig  Json?
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  versions       FlowVersion[]
  timers         FlowTimer[]
  nodeStats      FlowNodeStat[]

  @@index([organizationId])
  @@map("flows")
}

/// Maestro v2 — snapshot imutável por publicação/refresh/restore. Nunca editar nem deletar (só cascata da org via Flow).
model FlowVersion {
  id             String          @id @default(cuid())
  flowId         String
  flow           Flow            @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organizationId String
  version        Int
  name           String
  nodes          Json
  edges          Json
  triggerType    FlowTriggerType
  triggerConfig  Json?
  source         String // 'publish' | 'refresh' | 'restore'
