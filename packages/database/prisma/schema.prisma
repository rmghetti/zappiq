generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector, uuidOssp(map: "uuid-ossp")]
}

// ═══════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════

enum PlanType {
  STARTER
  GROWTH
  SCALE
  BUSINESS
  ENTERPRISE
}

enum UserRole {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  AGENT
  AUDITOR
}

enum ConversationStatus {
  OPEN
  WAITING
  ASSIGNED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
  INTERACTIVE
  LOCATION
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum CampaignType {
  BROADCAST
  TRIGGER
  SEQUENCE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED
}

enum FlowTriggerType {
  KEYWORD
  FIRST_CONTACT
  SCHEDULE
  MANUAL
  EVENT
  // Adicionados em 2026-05-28 pra cobrir os templates Maestro V1
  CUSTOM
  CART_ABANDONED
  TIMEOUT_24H
  TIMEOUT_48H
  TIMEOUT_14D
  TIMEOUT_30D
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

// LGPD Art. 7 + Art. 11 — bases legais de tratamento
enum LegalBasis {
  CONSENT               // Art. 7, I / Art. 11, I
  CONTRACT              // Art. 7, V
  LEGAL_OBLIGATION      // Art. 7, II
  LEGITIMATE_INTEREST   // Art. 7, IX
  VITAL_INTERESTS       // Art. 7, VII
  PUBLIC_INTEREST       // Art. 7, III
  CREDIT_PROTECTION     // Art. 7, X
  HEALTH_PROTECTION     // Art. 11, II, f
}

// Tipos de requisição do titular — LGPD Art. 18
enum DataSubjectRequestType {
  ACCESS          // confirmação + acesso
  CORRECTION      // correção
  ANONYMIZATION   // anonimização
  PORTABILITY     // portabilidade
  DELETION        // eliminação
  CONSENT_REVOKE  // revogação de consentimento
  INFORMATION     // informação sobre compartilhamento
}

enum DataSubjectRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  EXPIRED
}

// ═══════════════════════════════════════════════════════
// MODELS
// ═══════════════════════════════════════════════════════

model Organization {
  id                        String   @id @default(cuid())
  name                      String
  slug                      String   @unique
  plan                      PlanType @default(STARTER)
  whatsappPhoneNumberId     String?
  whatsappBusinessAccountId String?
  whatsappAccessToken       String?
  // FASE 4 (#251) — Instagram Direct Messaging via Meta Graph API.
  // instagramAccountId: ID da IG Business Account (ex: 17841...)
  // instagramPageId: Facebook Page ID linkada à conta IG (necessária pelo Meta)
  // instagramAccessToken: Page Access Token de longa duração (60 dias, renovável)
  instagramAccountId     String? @map("instagram_account_id")
  instagramPageId        String? @map("instagram_page_id")
  instagramAccessToken   String? @map("instagram_access_token") @db.Text
  // Self-serve "traga seu token": app secret do app Meta DO CLIENTE, usado pra
  // verificar a assinatura (x-hub-signature-256) dos webhooks WA/IG que chegam
  // assinados pelo app dele. Sem isso (ex.: Iza, ou cliente sob o app da ZappIQ)
  // o webhook cai no META_APP_SECRET global. Ver [[canais-self-serve-token-por-org]].
  metaAppSecret          String? @map("meta_app_secret")
  settings                  Json     @default("{}")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // LGPD — retenção customizável por organização (dias).
  // Default conservador: 1825d (5 anos) audit / 730d (2 anos) soft-deleted.
  auditRetentionDays        Int      @default(1825)
  softDeleteRetentionDays   Int      @default(730)
  dpoEmail                  String?  // Art. 41 — contato do encarregado

  // ── Trial (14 dias com cap de custo LLM) ────────────────
  // trialStartedAt/trialEndsAt: janela do período grátis.
  // trialCostCapUsd: teto de LLM que o tenant pode queimar no trial
  // para não impactar margem em signups curiosos/abusivos.
  // trialConverted: marca que o trial virou assinatura paga.
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  trialCostCapUsd    Float       @default(15.00)
  trialConverted     Boolean     @default(false)
  isTrialActive      Boolean     @default(true)

  // ── Billing cycle sinc com Stripe ───────────────────────
  billingCycle       String?     // "monthly" | "annual"
  subscriptionStatus String?     // active | past_due | canceled | trialing

  users              User[]
  contacts           Contact[]
  conversations      Conversation[]
  campaigns          Campaign[]
  flows              Flow[]
  knowledgeBases     KnowledgeBase[]
  agents             Agent[]            // V2-021 (Sprint 0 §11.3)
  templates          MessageTemplate[]
  dataSubjectRequests DataSubjectRequest[]
  tenantUsageMonthly TenantUsageMonthly[]
  qaPairs            QAPair[]
  onboardingJourneyStates OnboardingJourneyState[]  // FASE 1.B task #240
  // CRM sinérgico (Onda 0): pipeline, timeline de atividades e tarefas por org.
  pipelineStages     PipelineStage[]
  activities         Activity[]
  tasks              Task[]
  flowNodeStats      FlowNodeStat[]

  // ── Self-service AI training (maturação da IA pelo próprio cliente) ──
  // Score 0-100 cacheado. Atualizado a cada mutação relevante (upload de doc,
  // criação de Q&A, preenchimento de survey). Exposto no dashboard como
  // "termômetro" guiando o cliente ao próximo passo de qualificação da IA.
  aiReadinessScore   Int         @default(0)
  aiReadinessUpdatedAt DateTime?
  // Data em que o cliente finalizou a configuração inicial recomendada
  // (survey mínimo + 1 doc/URL + 3 Q&As). Marco usado para campanhas de
  // ativação e para o NPS do onboarding.
  aiTrainingReadyAt  DateTime?

  @@map("organizations")
}

// ═══════════════════════════════════════════════════════════
// TenantUsageMonthly — H10 unit economics por tenant
// Agregado denormalizado atualizado por job diário.
// Permite responder "esse cliente dá lucro?" em milissegundos.
// ═══════════════════════════════════════════════════════════
model TenantUsageMonthly {
  id                   String   @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Janela mensal no formato YYYY-MM (ex: "2026-04").
  periodYearMonth      String
  // Consumo bruto observado.
  llmCostUsd           Float    @default(0)
  llmInputTokens       BigInt   @default(0)
  llmOutputTokens      BigInt   @default(0)
  aiMessagesProcessed  Int      @default(0)
  broadcastsSent       Int      @default(0)
  conversationsOpened  Int      @default(0)
  conversationsClosed  Int      @default(0)
  conversationsAiResolved    Int      @default(0)
  conversationsHumanResolved Int      @default(0)
  handoffsCount        Int      @default(0)
  // Receita reconhecida no período (derivada do plano × cycle).
  revenueBrlCents      Int      @default(0)
  // Custo da infra atribuído ao tenant (fly/supabase/loki) — rateio proporcional.
  infraCostUsd         Float    @default(0)
  // Gross margin derivada = (revenue - llmCost - infraCost) / revenue.
  grossMarginPercent   Float?
  computedAt           DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([organizationId, periodYearMonth])
  @@index([periodYearMonth])
  @@map("tenant_usage_monthly")
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  name                  String
  passwordHash          String
  role                  UserRole @default(AGENT)
  avatar                String?
  isOnline              Boolean  @default(false)
  maxConcurrentChats    Int      @default(5)
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]
  deletedConversations  Conversation[] @relation("DeletedConversations")
  messages              Message[]
  auditLogs             AuditLog[]
  createdAt             DateTime @default(now())

  @@index([organizationId])
  @@map("users")
}

model Contact {
  id                 String     @id @default(cuid())
  whatsappId         String
  // FASE 4 (#251): IGSID — Instagram-Scoped ID que Meta retorna na DM.
  // É um ID estável por usuário POR conta IG Business (não global).
  // Permite identificar/dedup contato que mandou DM sem precisar do username.
  instagramScopedId  String?    @map("instagram_scoped_id")
  phone              String
  name               String?
  email              String?
  company            String?
  avatarUrl          String?
  tags               String[]   @default([])
  customFields       Json       @default("{}")
  leadScore          Int        @default(0)
  leadStatus         LeadStatus @default(NEW)
  funnelStage        String     @default("new")
  birthDate          DateTime?
  lastInteractionAt  DateTime?
  consentMarketing   Boolean    @default(false)
  consentMarketingAt DateTime?
  // CRM (Onda 0): atribuição de origem (campanha que originou) + first/last touch.
  sourceCampaignId   String?
  firstTouchAt       DateTime?
  lastTouchAt        DateTime?
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  deals              Deal[]
  activities         Activity[]
  tasks              Task[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([whatsappId, organizationId])
  @@unique([instagramScopedId, organizationId], name: "instagramScopedId_organizationId")
  @@index([organizationId])
  @@index([phone])
  @@index([leadStatus])
  @@map("contacts")
}

model Conversation {
  id               String             @id @default(cuid())
  status           ConversationStatus @default(OPEN)
  channel          String             @default("whatsapp")
  sentiment        Sentiment?
  urgency          Urgency?
  summary          String?
  csatScore        Int?
  assignedToId     String?
  assignedTo       User?              @relation(fields: [assignedToId], references: [id])
  contactId        String
  contact          Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages         Message[]
  internalNotes    InternalNote[]
  activities       Activity[]
  currentFlowState Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  closedAt         DateTime?
  deletedAt        DateTime?          // LGPD Art. 16 — marcação de exclusão
  deletedById      String?
  deletedBy        User?              @relation("DeletedConversations", fields: [deletedById], references: [id])
  deletionReason   String?            // motivo (DSR, operacional, purge por retenção)
  anonymizedAt     DateTime?          // LGPD Art. 12 — anonimização de PII

  @@index([organizationId])
  @@index([contactId])
  @@index([status])
  @@index([assignedToId])
  @@index([deletedAt])
  @@map("conversations")
}

model Message {
  id                String           @id @default(cuid())
  whatsappMessageId String?          @unique
  // FASE 4 (#251): ID externo do canal (Instagram, futuramente outros).
  // Permite dedup de inbound + correlação de status callbacks.
  // Polimórfico: vale pra IG hoje, web chat session-msg amanhã.
  externalMessageId String?          @unique @map("external_message_id")
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  content           String
  mediaUrl          String?
  mediaType         String?
  templateName      String?
  status            MessageStatus    @default(SENT)
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId          String?
  sender            User?            @relation(fields: [senderId], references: [id])
  isFromBot         Boolean          @default(false)
  aiConfidence      Float?
  metadata          Json?
  createdAt         DateTime         @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

model Campaign {
  id             String         @id @default(cuid())
  name           String
  type           CampaignType
  status         CampaignStatus @default(DRAFT)
  templateId     String?
  template       MessageTemplate? @relation(fields: [templateId], references: [id])
  audienceFilter Json
  scheduledAt    DateTime?
  sentCount      Int            @default(0)
  deliveredCount Int            @default(0)
  readCount      Int            @default(0)
  repliedCount   Int            @default(0)
  failedCount    Int            @default(0)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  @@index([organizationId])
  @@index([status])
  @@map("campaigns")
}

model Flow {
  id             String          @id @default(cuid())
  name           String
  description    String?
  nodes          Json
  edges          Json
  isActive       Boolean         @default(false)
  version        Int             @default(1)
  priority       Int             @default(0)
  triggerType    FlowTriggerType
  triggerConfig  Json?
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  versions       FlowVersion[]
  timers         FlowTimer[]
  nodeStats      FlowNodeStat[]

  @@index([organizationId])
  @@map("flows")
}

/// Maestro v2 — snapshot imutável por publicação/refresh/restore. Nunca editar nem deletar (só cascata da org via Flow).
model FlowVersion {
  id             String          @id @default(cuid())
  flowId         String
  flow           Flow            @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organizationId String
  version        Int
  name           String
  nodes          Json
  edges          Json
  triggerType    FlowTriggerType
  triggerConfig  Json?
  source         String          // 'publish' | 'refresh' | 'restore'
  createdById    String?
  createdAt      DateTime        @default(now())

  @@unique([flowId, version])
  @@index([organizationId])
  @@map("flow_versions")
}

/// Maestro 1B-analytics — contadores por nó/dia (funil/drop-off).
model FlowNodeStat {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flowId         String
  flow           Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  nodeId         String
  nodeType       String
  nodeLabel      String?
  period         String   // 'YYYY-MM-DD' UTC
  entries        Int      @default(0)
  ends           Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([flowId, nodeId, period])
  @@index([organizationId, flowId])
  @@map("flow_node_stats")
}

/// Maestro v2 — espera durável de wait/schedule (fonte de verdade; o job BullMQ é só o despertador).
model FlowTimer {
  id             String    @id @default(cuid())
  organizationId String
  /// Sem FK para conversations: intencional. Timers são limpos via cascade do flow e validados no momento do disparo; uma purga de conversa deixa apenas linhas inertes.
  conversationId String
  flowId         String
  flow           Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowVersion    Int
  kind           String    // 'wait' | 'schedule'
  resumeNodeId   String
  stateSnapshot  Json
  runAt          DateTime
  status         String    @default("pending") // 'pending' | 'fired' | 'cancelled' | 'expired'
  statusReason   String?
  jobId          String?
  createdAt      DateTime  @default(now())
  firedAt        DateTime?

  @@index([status, runAt])
  @@index([organizationId, conversationId, status])
  @@map("flow_timers")
}

model FlowTemplate {
  id            String                  @id @default(cuid())
  name          String
  description   String
  vertical      FlowTemplateVertical
  category      FlowTemplateCategory
  nodes         Json
  edges         Json
  triggerType   FlowTriggerType
  triggerConfig Json?
  order         Int                     @default(0)
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([vertical])
  @@index([category])
  @@map("flow_templates")
}

enum FlowTemplateVertical {
  DENTISTA
  SALAO_BELEZA
  ACADEMIA
  PETSHOP
  ECOMMERCE_MODA
  // Adicionados 2026-05-28 (Patch B)
  PSICOLOGO
  ADVOGADO
  NUTRICIONISTA
  IMOBILIARIA
  RESTAURANTE
  ESCOLA
  SERVICOS_TECNICOS
  CLINICA_MEDICA
  CONTABILIDADE
  OFICINA
  AGENCIA_DIGITAL
}

enum FlowTemplateCategory {
  BOAS_VINDAS_QUALIFICACAO
  AGENDAMENTO_RECUPERACAO
  NPS_POS_VENDA
}

model KnowledgeBase {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      KBDocument[]
  agents         Agent[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("knowledge_bases")
}

model KBDocument {
  id              String        @id @default(cuid())
  title           String
  sourceType      String
  sourceUrl       String?
  content         String
  chunks          KBChunk[]
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@map("kb_documents")
}

// V2-019 (Sprint 0 Blocker 5): embedding alinhado ao canônico
// Voyage voyage-3 1024 dim. Ver ADR docs/architecture/embeddings.md.
// Migration: 20260427_kbchunk_vector_1024.
model KBChunk {
  id         String                          @id @default(cuid())
  content    String
  embedding  Unsupported("vector(1024)")?
  metadata   Json?
  documentId String
  document   KBDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("kb_chunks")
}

// ═══════════════════════════════════════════════════════════════════
// QAPair — Perguntas & Respostas editáveis pelo cliente
// ─────────────────────────────────────────────────────────────────
// Estrutura explícita (pergunta → resposta) para casos em que o cliente
// quer "fixar" uma resposta sem depender de RAG de documento longo.
// Ingerido como chunks no vector store, mas mantido como registro
// canônico editável no CRUD. Categoria opcional para agrupamento
// (ex.: "horário de atendimento", "política de trocas", "pricing").
// ═══════════════════════════════════════════════════════════════════
model QAPair {
  id             String       @id @default(cuid())
  question       String
  answer         String
  category       String?
  priority       Int          @default(0)       // ordem de exibição / peso no RAG
  isActive       Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // ID do chunk correspondente no vector store — permite resync sem duplicar.
  ragChunkId     String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("qa_pairs")
}

model Deal {
  id             String   @id @default(cuid())
  title          String
  value          Decimal?
  // Legado: estágio textual livre. Mantido p/ back-compat; a fonte canônica
  // passa a ser stageId (PipelineStage). Sincronizados na transição.
  stage          String   @default("new")
  stageId        String?
  pipelineStage  PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  // CRM (Onda 0): dono, previsão, atribuição e desfecho.
  ownerId           String?
  expectedCloseDate DateTime?
  lossReason        LossReason?
  sourceCampaignId  String?
  sourceAgentId     String?
  wonAt             DateTime?
  lostAt            DateTime?
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId String
  activities     Activity[]
  tasks          Task[]
  closedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@index([stageId])
  @@map("deals")
}

// ═══════════════════════════════════════════════════════════════════
// CRM sinérgico (Onda 0) — pipeline + timeline de atividades + tarefas
// ─────────────────────────────────────────────────────────────────
// PipelineStage: estágios ordenáveis por org (seed: Novo→...→Ganho/Perdido).
// Activity: feed cronológico unificado (mensagens, mudança de estágio, notas,
//   tarefas, eventos de campanha, resumos da IA) — fonte da timeline do contato.
// Task: próximo passo com dono e prazo, ligado a contato/deal.
// ═══════════════════════════════════════════════════════════════════
enum ActivityType {
  CONTACT_CREATED
  MESSAGE
  STAGE_CHANGE
  NOTE
  TASK_CREATED
  TASK_COMPLETED
  CAMPAIGN_EVENT
  AI_SUMMARY
  FIELD_UPDATE
  LEAD_SCORE_CHANGE
  DEAL_CREATED
  DEAL_WON
  DEAL_LOST
}

enum ActorType {
  HUMAN
  AI
  SYSTEM
}

enum TaskStatus {
  PENDING
  DONE
  CANCELLED
}

enum LossReason {
  PRICE
  COMPETITOR
  TIMING
  NO_DECISION
  NO_BUDGET
  NO_RESPONSE
  OTHER
}

model PipelineStage {
  id             String       @id @default(cuid())
  name           String
  order          Int          @default(0)
  color          String?
  isWon          Boolean      @default(false)
  isLost         Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals          Deal[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("pipeline_stages")
}

model Activity {
  id             String       @id @default(cuid())
  type           ActivityType
  actor          ActorType    @default(SYSTEM)
  actorUserId    String?
  title          String
  body           String?
  metadata       Json?
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
  @@index([conversationId])
  @@index([createdAt])
  @@map("activities")
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus   @default(PENDING)
  dueDate        DateTime?
  assignedToId   String?
  completedAt    DateTime?
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
  @@index([status])
  @@index([assignedToId])
  @@map("tasks")
}

model MessageTemplate {
  id              String   @id @default(cuid())
  name            String
  category        String
  language        String   @default("pt_BR")
  headerType      String?
  headerContent   String?
  bodyText        String
  footerText      String?
  buttons         Json?
  metaStatus      String   @default("PENDING")
  metaTemplateId  String?
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns       Campaign[]
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@map("message_templates")
}

model InternalNote {
  id             String       @id @default(cuid())
  content        String
  authorId       String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("internal_notes")
}

// LGPD Art. 37 (ROPA) + Art. 46 (segurança) + Art. 48 (incidentes)
// Cadeia hash garante detecção de adulteração. Append-only via policy de banco.
model AuditLog {
  id             String      @id @default(cuid())
  sequence       BigInt      @default(autoincrement())  // ordem estrita p/ cadeia
  action         String                                  // e.g. "conversation.delete"
  resource       String                                  // e.g. "conversation"
  resourceId     String?                                 // id do recurso tocado
  purpose        String?                                 // LGPD Art. 6 — finalidade
  legalBasis     LegalBasis?                             // LGPD Art. 7/11
  dataSubjectId  String?                                 // contactId quando toca dados pessoais
  details        Json?
  before         Json?                                   // snapshot antes (forense)
  after          Json?                                   // snapshot depois
  ipAddress      String?
  userAgent      String?
  hash           String?                                 // SHA-256 do registro (null em linhas legacy)
  prevHash       String?                                 // hash do registro anterior (chain)
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  organizationId String
  anonymizedAt   DateTime?                               // LGPD Art. 16 — marcado ao anonimizar
  createdAt      DateTime    @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([resource, resourceId])
  @@index([dataSubjectId])
  @@index([createdAt])
  @@index([sequence])
  @@map("audit_logs")
}

// LGPD Art. 18 — requisições do titular dos dados
model DataSubjectRequest {
  id             String                   @id @default(cuid())
  type           DataSubjectRequestType
  status         DataSubjectRequestStatus @default(PENDING)
  requesterEmail String                                      // email do titular
  requesterName  String?
  contactId      String?                                     // Contact.id se identificado
  reason         String?                                     // justificativa do titular
  responseData   Json?                                       // payload da resposta (para ACCESS/PORTABILITY)
  handledById    String?                                     // user.id do operador
  rejectionReason String?
  dueDate        DateTime                                    // prazo legal (15 dias — Art. 19)
  completedAt    DateTime?
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([contactId])
  @@index([dueDate])
  @@map("data_subject_requests")
}

model Consent {
  id        String    @id @default(cuid())
  contactId String
  type      String
  status    String
  grantedAt DateTime?
  revokedAt DateTime?
  channel   String?
  createdAt DateTime  @default(now())

  @@index([contactId])
  @@map("consents")
}

// ═══════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════
// V2-021 · Agent (Sprint 0 — Plano §11.3)
// Persona configurável por Organization. 2 seed por org:
// comercial (lead/trial) + suporte (customer). Builder
// self-service Q3 estende esse modelo.
// ═══════════════════════════════════════════════════════
model Agent {
  id              String          @id @default(uuid()) @db.Text
  organizationId  String          @map("organization_id")
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String          // "Iza", "Bella", "Ana"
  role            String          // 'comercial' | 'suporte' | 'onboarding' | 'financeiro'
  status          String          @default("live") // 'draft' | 'reviewed' | 'live'
  systemPrompt    String          @map("system_prompt") @db.Text
  toneConfig      Json            @default("{}") @map("tone_config")
  scopeConfig     Json            @default("{}") @map("scope_config")
  abilities       Json            @default("{}")
  knowledgeBaseId String?         @map("knowledge_base_id")
  knowledgeBase   KnowledgeBase?  @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  voiceConfig     Json?           @map("voice_config") // null até voz voltar Q3
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  evalRuns        AgentEvalRun[]

  @@index([organizationId, role, status])
  @@map("agents")
}

// FASE 1.B task #240 — Onboarding journey D+1/D+3/D+7 state.
// Idempotência: 1 row por (org, stage). Reusa templates existentes
// (trialSavingsFollowup, trialMidway, trialLastDay) wireados via
// onboardingJourneyService.ts. Cron horário no boot do server.
model OnboardingJourneyState {
  id              String       @id @default(uuid()) @db.Text
  organizationId  String       @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage           String       // 'D1' | 'D3' | 'D7'
  sentAt          DateTime     @default(now()) @map("sent_at")
  emailProviderId String?      @map("email_provider_id") // Resend ID ou 'log:...'
  templateId      String       @map("template_id")
  // Snapshot da org no momento do send (debug)
  orgSnapshot     Json?        @map("org_snapshot")

  @@unique([organizationId, stage])
  @@index([sentAt])
  @@map("onboarding_journey_state")
}

// V3.2 task #237 — Persistência de eval runs (golden set scoring).
// Roda sob demanda (manual via API) ou via cron diário (V3.3 futuro).
// Permite histórico de score por agent + alerta se degrada.
model AgentEvalRun {
  id                String    @id @default(uuid()) @db.Text
  agentId           String    @map("agent_id")
  agent             Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // 'pending' (criada, ainda não rodou) | 'running' | 'completed' | 'failed'
  status            String    @default("pending")
  // Versão do eval set usada (ex: 'v1') — pra rastrear quando set muda
  evalSetVersion    String    @map("eval_set_version")
  // Versão do CORE rules usada (ex: 'v1') — pra rastrear quando CORE muda
  coreRulesVersion  String?   @map("core_rules_version")
  // Trigger: 'manual' | 'cron' | 'pre_release'
  triggeredBy       String    @default("manual") @map("triggered_by")
  // Scenarios rodados (subset filter aplicado) — null = todos
  scenarioFilter    Json?     @map("scenario_filter")
  // Métricas agregadas
  totalScenarios    Int?      @map("total_scenarios")
  passed            Int?
  partial           Int?
  failed            Int?
  criticalFailed    Int?      @map("critical_failed")
  scorePercent      Int?      @map("score_percent")
  // Resultado completo (todos os ScenarioResult em JSON)
  results           Json?
  // Erro (se status=failed)
  error             String?   @db.Text
  // Timing
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  durationMs        Int?      @map("duration_ms")
  // FASE 2.2a (#243) — instrumentação Slack (diagnóstico de falhas silenciosas)
  // 'skipped' (não cruzou threshold) | 'sent' | 'failed' (com slackAlertError)
  slackAlertStatus  String?   @map("slack_alert_status")
  slackAlertError   String?   @db.Text @map("slack_alert_error")
  slackAlertSentAt  DateTime? @map("slack_alert_sent_at")

  fixDecisions      AgentEvalFixDecision[]

  @@index([agentId, startedAt])
  @@index([status])
  @@map("agent_eval_runs")
}

// FASE 2.2a (#243) — Audit log de decisões de aplicar/recusar sugestões IA.
// Quando admin/cliente clica "Aplicar Sugestão" no dashboard, snapshot do
// prompt antes/depois é persistido aqui pra rollback + audit.
model AgentEvalFixDecision {
  id              String        @id @default(uuid()) @db.Text
  runId           String        @map("run_id")
  run             AgentEvalRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  scenarioId      String        @map("scenario_id") // ex: cr5_nome_disponivel_usar
  agentId         String        @map("agent_id")
  // 'applied' | 'rejected' | 'reverted'
  decision        String
  // Snapshot da sugestão original (JSONB: summary + patches + confidence)
  originalSuggestion Json?     @map("original_suggestion")
  // Diff final efetivamente aplicado (pode ter sido editado pelo user)
  finalDiff       String?       @db.Text @map("final_diff")
  // Snapshot do system_prompt antes (rollback) e depois
  promptBefore    String?       @db.Text @map("prompt_before")
  promptAfter     String?       @db.Text @map("prompt_after")
  // Audit: quem decidiu
  decidedById     String?       @map("decided_by_id")
  decidedByEmail  String        @map("decided_by_email") // snapshot
  decidedByName   String?       @map("decided_by_name")  // snapshot
  decidedByRole   String?       @map("decided_by_role")  // SUPERADMIN | ADMIN
  decidedAt       DateTime      @default(now()) @map("decided_at")
  // Motivo opcional (preenche em 'rejected' ou notas em 'applied')
  notes           String?       @db.Text
  // Se reverted, aponta pra decision original
  revertedFromId  String?       @map("reverted_from_id")

  @@index([runId])
  @@index([agentId, decidedAt])
  @@index([scenarioId])
  @@map("agent_eval_fix_decisions")
}

// V2-018 · llm_call_logs (Sprint 0 Blocker 1)
// Audit por turn das chamadas LLM via LLMRouter.
// Não polui audit_logs (hash chain) — ver migration.sql para racional.
// ═══════════════════════════════════════════════════════
model LLMCallLog {
  id                  String   @id @default(uuid()) @db.Text
  organizationId      String?  @map("organization_id")
  conversationId      String?  @map("conversation_id")
  provider            String   // 'anthropic-sonnet' | 'anthropic-haiku' | 'openai-mini' | 'none'
  model               String   // 'claude-sonnet-4-6' | etc
  operation           String   @default("chat") // 'chat' | 'classify' | 'sentiment'
  inputTokens         Int?     @map("input_tokens")
  outputTokens        Int?     @map("output_tokens")
  costUsdEstimate     Decimal? @map("cost_usd_estimate") @db.Decimal(10, 6)
  latencyMs           Int      @map("latency_ms")
  fallbackTriggered   Boolean  @default(false) @map("fallback_triggered")
  attemptCount        Int      @default(1) @map("attempt_count")
  error               String?
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([provider, createdAt])
  @@map("llm_call_logs")
}
